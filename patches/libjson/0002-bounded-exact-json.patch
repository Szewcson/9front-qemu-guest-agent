+JSON*
+jsonparsebounded(char *s, ulong n, JSONLimits *limits)
+{
+	Lex l;
+	JSON *j;
+	Rune end;
+
+	if(s == nil || limits == nil || n > 0x7FFFFFFF-UTFmax-1 ||
+	   limits->maxdepth > JSONMaxDepth || limits->maxnodes == 0 ||
+	   limits->maxbytes < n+UTFmax+1){
+		werrstr("json: invalid limits or input length");
+		return nil;
+	}
+	memset(&l, 0, sizeof l);
+	l.s = s;
+	l.end = s+n;
+	l.slen = n+1;
+	l.bounded = 1;
+	l.limits = *limits;
+	if((l.buf = jsonalloc(&l, n+UTFmax+1)) == nil)
+		return nil;
+	j = jsonobj(&l, 0);
+	end = peeknonspace(&l);
+	free(l.buf);
+	if(l.bad || end != 0){
+		jsonfree(j);
+		werrstr("json: invalid or trailing data");
+		return nil;
+	}
+	return j;
+}
